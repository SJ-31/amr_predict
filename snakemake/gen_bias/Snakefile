rule find_motifs:
    input:
        generated=f"{OUTDIR}/generated/{{model}}/{{prompt}}.fasta",
        prompt=f"{PROMPTS}/{{prompt}}.fasta",
        prompt_full=f"{PROMPTS_FULL}/{{prompt}}.fasta",
    singularity:
        ENV.singularity.get("find_motifs")
    output:
        tsv=f"{OUTDIR}/motifs/{{model}}/{{prompt}}.tsv",
        tmp=temp(f"{OUTDIR}/motifs/{{model}}/{{prompt}}.fasta"),
    params:
        thresh=ENV.fimo.thresh,
        motifs=lambda wc: ENV.get_motif_file(wc["prompt"]),
    shell:
        """
        fimo --thresh {params.thresh} \
             --skip-matched-sequence \
             {params.motifs} {input.prompt_full} > {output[0]}
        fimo --thresh {params.thresh} \
             --skip-matched-sequence \
             {params.motifs} {input.generated} >> {output[0]}        
        """


rule classify_taxonomy:
    input:
        generated=f"{OUTDIR}/generated/{{model}}/{{prompt}}.fasta",
        prompt_full=f"{PROMPTS_FULL}/{{prompt}}.fasta",
    params:
        db=ENV.taxdb,
    threads: 4
    singularity:
        ENV.singularity.get("classify_taxonomy")
    output:
        f"{OUTDIR}/taxonomy/{{model}}/.{{prompt}}/mmseqs_tophit_aln",
        f"{OUTDIR}/taxonomy/{{model}}/.{{prompt}}/mmseqs_report",
        f"{OUTDIR}/taxonomy/{{model}}/.{{prompt}}/mmseqs_lca.tsv",
        f"{OUTDIR}/taxonomy/{{model}}/.{{prompt}}/mmseqs_tophit_report",
    shell:
        f"""
        mmseqs easy-taxonomy {{input.generated}} {{input.prompt_full}} \
                {{params.db}} \
                {OUTDIR}/taxonomy/{{wildcards.model}}/.{{wildcards.prompt}}/mmseqs \
                {OUTDIR}/taxonomy/{{wildcards.model}}/.{{wildcards.prompt}}_tmp \
                --tax-lineage 1 \
                --format-mode 4 \
                --search-type 3
        """


rule sort_taxonomy_hits:
    input:
        f"{OUTDIR}/taxonomy/{{model}}/.{{prompt}}/mmseqs_tophit_aln",
    output:
        f"{OUTDIR}/taxonomy/{{model}}/{{prompt}}.csv",
    run:
        import polars as pl

        # Sort by evalue then bitscore ranking i.e. pick sequences with the lowest evalue,
        # (likely to have multiple sequences with the same evalue)
        # then get the best hit by bitscore
        df = pl.read_csv(input[0], separator="\t").with_columns(
            rank=pl.col("evalue").rank().over("query")
        )
        best_evalue = df.group_by("query").agg(min_rank=pl.col("rank").min())
        df = (
            df.join(best_evalue, on="query")
            .filter(pl.col("rank") == pl.col("min_rank"))
            .drop(["rank", "min_rank"])
        )
        df = (
            df.group_by("query")
            .agg(pl.all().top_k_by(k=1, by="bits"))
            .explode(pl.all().exclude("query"))
        )
        df.write_csv(output[0])


# * Sequence similarity


rule similarity:
    input:
        generated=f"{OUTDIR}/generated/{{model}}/{{prompt}}.fasta",
        prompt_full=f"{PROMPTS_FULL}_trimmed/{{prompt}}.fasta",
    params:
        kws="",
    output:
        "PLACEHOLDER",
    shell:
        f"""
        parasail_aligner -x \
                -a {ENV.parasail.fn} \
                -e {ENV.parasail.gap_extend} \
                -o {ENV.parasail.gap_open} \
                -m {ENV.parasail.matrix} \
                -M {ENV.parasail.match} \
                -X {ENV.parasail.mismatch} \
                {{params.kws}} -g {{output[0]}}
        """
        # Require -x flag to ensure that no sequence pair is omitted from comparison


use rule similarity as similarity_to_prompt with:
    params:
        kws=lambda _, input: " ".join(
            ["-d", "-q", input.prompt_full, "-f", input.generated]
        ),
    singularity:
        ENV.singularity.get("similarity")
    output:
        temp(f"{OUTDIR}/.similarity_tmp_nuc/{{model}}/{{prompt}}-to_prompt.csv"),


use rule similarity as similarity_self with:
    params:
        kws=lambda _, input: " ".join(["-d", "-f", input.generated]),
    singularity:
        ENV.singularity.get("similarity")
    output:
        temp(f"{OUTDIR}/.similarity_tmp_nuc/{{model}}/{{prompt}}-self.csv"),


use rule similarity as aa_similarity_to_prompt with:
    input:
        generated=f"{OUTDIR}/generated_aa/{{model}}/{{prompt}}.fasta",
        prompt_full=f"{PROMPTS_FULL}_aa/{{prompt}}.fasta",
    params:
        kws=lambda _, input: " ".join(["-q", input.prompt_full, "-f", input.generated]),
    singularity:
        ENV.singularity.get("similarity")
    output:
        temp(f"{OUTDIR}/.similarity_tmp_aa/{{model}}/{{prompt}}-to_prompt.csv"),


use rule similarity as aa_similarity_self with:
    input:
        generated=f"{OUTDIR}/generated_aa/{{model}}/{{prompt}}.fasta",
    params:
        kws=lambda _, input: " ".join(["-d", "-f", input.generated]),
    singularity:
        ENV.singularity.get("similarity")
    output:
        temp(f"{OUTDIR}/.similarity_tmp_aa/{{model}}/{{prompt}}-self.csv"),


rule fmt_similarity:
    input:
        index=f"{INDICES}/{{model}}/{{prompt}}",
        tmp=f"{OUTDIR}/.similarity_tmp_{{molecule}}/{{model}}/{{prompt}}-{{type}}.csv",
    singularity:
        ENV.singularity.get("fmt_similarity")
    params:
        cols=",".join(
            [
                "query",
                "index",
                "length1",
                "length2",
                "score",
                "end_query",
                "end_ref",
                "n_matches",
                "similarities",
                "length",
            ]
        ),
    output:
        f"{OUTDIR}/{{molecule}}_similarity/{{model}}/{{prompt}}-{{type}}.csv",
    shell:
        """
        if [[ {wildcards.type} == 'to_prompt' ]]; then
            xan rename -n {params.cols} {input.tmp} | \
                  xan join index {input.index} - | \
                  xan transform query '"{wildcards.prompt}"' |
                  xan drop index > {output[0]}
        else
            xan rename -n {params.cols} {input.tmp} | \
                  xan join index {input.index} - | \
                  xan drop index | \
                  xan join -r right_ query - index {input.index} | \
                  xan drop right_index,query | \
                  xan rename --replace right_id query > {output[0]}
         fi
         """
