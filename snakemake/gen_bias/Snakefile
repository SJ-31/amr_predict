from pathlib import Path
import time
from env import SnakeEnv
import os


configfile: "env.yaml"


"""
Output is structured as

<outdir>/
├── generated/
│   └── <model_name>/
│       └── <prefix_name>.fasta
├── prefix_comparison.csv
├── perturbation_sensitivity.csv
├── motifs_domains.csv
└── physicochemical.csv
"""

ENV = SnakeEnv.new(config)
OUTDIR = ENV.outdir
OUTPUTS = ENV.get_outputs()
PREFIXES = OUTDIR / ".prefixes"
INDICES = OUTDIR / ".indices"
PREFIXES_FULL = OUTDIR / ".prefixes_full"

os.environ["HF_HOME"] = ENV.huggingface

CUDA_VISIBLE_DEVICES = os.environ.get("CUDA_VISIBLE_DEVICES", 0)
# Pass the correct visible devices into the container
# Is an issue when using the `--cleanenv` flag


rule all:
    input:
        *OUTPUTS["generated"],
        *OUTPUTS["motifs"],
        *OUTPUTS["taxonomy"],
        *OUTPUTS["similarity"],
        # *OUTPUTS["metrics"], # TODO: uncomment after finishing


rule fmt_prefixes:
    output:
        f"{PREFIXES}/{{prefix}}.fasta",
        f"{PREFIXES_FULL}/{{prefix}}.fasta",
        f"{PREFIXES_FULL}_aa/{{prefix}}.fasta",
        # Would have liked to make these temporary, if not for the fact
        # it would cause the workflow to re-run the `generate` rule
    params:
        prefix2data=ENV.prefix2data,
    script:
        "main.py"


rule generate:
    output:
        f"{OUTDIR}/generated/{{model}}/{{prefix}}.fasta",
    input:
        f"{PREFIXES}/{{prefix}}.fasta",
    params:
        script=lambda wc: ENV.model_script(wc.get("model")),
        kws=lambda wc: ENV.model_kws(wc.get("model")),
        n=lambda wc: ENV.prefix2data[wc.get("prefix")].get("n", ENV.n) or ENV.n,
        hf=ENV.huggingface,
        cvd=CUDA_VISIBLE_DEVICES,
    resources:
        **ENV.resources["gpu40"],
    singularity:
        lambda wc: ENV.model_image(wc["model"])
    shell:
        """
        export HF_HOME='{params.hf}'
        export CUDA_VISIBLE_DEVICES={params.cvd}
        python {params.script} {params.kws} \
                --prompt {input[0]} \
                --output {output[0]} \
                --prefix "{wildcards.model}_" \
                --num {params.n}
        """


rule gen_index:
    input:
        f"{OUTDIR}/generated/{{model}}/{{prefix}}.fasta",
    output:
        f"{INDICES}/{{model}}/{{prefix}}",
    shell:
        """
        grep '>' {input[0]} | sed 's/^>//' | xan -n rename id | \
                xan enum > {output[0]}
        """


rule translate_fasta:
    input:
        f"{OUTDIR}/generated/{{model}}/{{prefix}}.fasta",
    output:
        f"{OUTDIR}/generated_aa/{{model}}/{{prefix}}.fasta",
    script:
        "main.py"


rule describe_protein_seqs:
    input:
        prefix=f"{PREFIXES_FULL}_aa/{{prefix}}.fasta",
        generated=f"{OUTDIR}/generated_aa/{{model}}/{{prefix}}.fasta",
    output:
        mean=f"{OUTDIR}/protein_descriptor_means/{{model}}/{{prefix}}.csv",
        vals=f"{OUTDIR}/protein_descriptor_raw/{{model}}/{{prefix}}.csv",
    script:
        "main.py"


# rule compare_protein_descriptors:
