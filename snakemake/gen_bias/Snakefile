from pathlib import Path
import time
from env import SnakeEnv
import os


configfile: "env.yaml"


"""
Output is structured as

<outdir>/
├── generated/
│   └── <model_name>/
│       └── <prompt_name>.fasta
├── prompt_comparison.csv
├── perturbation_sensitivity.csv
├── motifs_domains.csv
└── physicochemical.csv
"""

ENV = SnakeEnv.new(config)
OUTDIR = ENV.outdir
OUTPUTS = ENV.get_outputs()
PROMPTS = OUTDIR / ".prompts"
INDICES = OUTDIR / ".indices"
PROMPTS_FULL = OUTDIR / ".prompts_full"

os.environ["HF_HOME"] = ENV.huggingface

CUDA_VISIBLE_DEVICES = os.environ.get("CUDA_VISIBLE_DEVICES", 0)
# Pass the correct visible devices into the container
# Is an issue when using the `--cleanenv` flag


rule all:
    input:
        *OUTPUTS["generated"],
        *OUTPUTS["motifs"],
        *OUTPUTS["taxonomy"],
        *OUTPUTS["nuc_similarity"],
        *OUTPUTS["aa_similarity"],
        *OUTPUTS["protein_descriptors"],


rule fmt_prompts:
    output:
        # Would have liked to make these temporary, if not for the fact
        # it would cause the workflow to re-run the `generate` rule
        prompt=f"{PROMPTS}/{{prompt}}.fasta",
        full_trimmed=f"{PROMPTS_FULL}_trimmed/{{prompt}}.fasta",
        full=f"{PROMPTS_FULL}/{{prompt}}.fasta",
        aa=f"{PROMPTS_FULL}_aa/{{prompt}}.fasta",
        aa_trimmed=f"{PROMPTS_FULL}_aa_trimmed/{{prompt}}.fasta",
        # `_trimmed` is the original prompt sequence without the
        # upstream component used for the prompt
        # for aa, trimming occurs prior to translation
    params:
        prompt2data=ENV.prompt2data,
    script:
        "main.py"


rule generate:
    output:
        f"{OUTDIR}/generated/{{model}}/{{prompt}}.fasta",
    input:
        f"{PROMPTS}/{{prompt}}.fasta",
    params:
        script=lambda wc: ENV.model_script(wc.get("model")),
        kws=lambda wc: ENV.model_kws(wc.get("model")),
        n=lambda wc: ENV.prompt2data[wc.get("prompt")].get("n", ENV.n) or ENV.n,
        hf=ENV.huggingface,
        cvd=CUDA_VISIBLE_DEVICES,
    resources:
        **ENV.resources["gpu40"],
    singularity:
        lambda wc: ENV.model_image(wc["model"])
    shell:
        """
        export HF_HOME='{params.hf}'
        export CUDA_VISIBLE_DEVICES={params.cvd}
        python {params.script} {params.kws} \
                --prompt {input[0]} \
                --output {output[0]} \
                --prefix "{wildcards.model}|" \
                --prepend_prompt_to_output False \
                --num {params.n}
        """


rule gen_index:
    input:
        f"{OUTDIR}/generated/{{model}}/{{prompt}}.fasta",
    output:
        f"{INDICES}/{{model}}/{{prompt}}",
    shell:
        """
        grep '>' {input[0]} | sed 's/^>//' | xan -n rename id | \
                xan enum > {output[0]}
        """


rule translate_fasta:
    input:
        f"{OUTDIR}/generated/{{model}}/{{prompt}}.fasta",
    output:
        f"{OUTDIR}/generated_aa/{{model}}/{{prompt}}.fasta",
    script:
        "main.py"


rule describe_protein_seqs:
    input:
        prompt_full=f"{PROMPTS_FULL}_aa_trimmed/{{prompt}}.fasta",
        generated=f"{OUTDIR}/generated_aa/{{model}}/{{prompt}}.fasta",
    output:
        mean=f"{OUTDIR}/protein_descriptors/{{model}}/{{prompt}}-means.csv",
        # For each descriptor, the mean difference of the generated sequence from the
        # prompt
        vals=f"{OUTDIR}/protein_descriptors/{{model}}/{{prompt}}-raw.csv",
    script:
        "main.py"


