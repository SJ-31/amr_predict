# across prefix groups


rule find_motifs:
    input:
        generated=f"{OUTDIR}/generated/{{model}}/{{prefix}}.fasta",
        prefix=f"{PREFIXES_FULL}/{{prefix}}.fasta",
    singularity:
        ENV.singularity.get("find_motifs")
    output:
        tsv=f"{OUTDIR}/motifs/{{model}}/{{prefix}}.tsv",
    params:
        thresh=ENV.fimo.thresh,
        motifs=lambda wc: ENV.get_motif_file(wc["prefix"]),
    shell:
        """
        fimo --thresh {params.thresh} \
             --skip-matched-sequence \
             {params.motifs} {input.prefix} > {output[0]}
        fimo --thresh {params.thresh} \
             --skip-matched-sequence \
             {params.motifs} {input.generated} >> {output[0]}        
        """


rule classify_taxonomy:
    input:
        generated=f"{OUTDIR}/generated/{{model}}/{{prefix}}.fasta",
        prefix=f"{PREFIXES_FULL}/{{prefix}}.fasta",
    params:
        db=ENV.taxdb,
    threads: 4
    singularity:
        ENV.singularity.get("classify_taxonomy")
    output:
        f"{OUTDIR}/taxonomy/{{model}}/.{{prefix}}/mmseqs_tophit_aln",
        f"{OUTDIR}/taxonomy/{{model}}/.{{prefix}}/mmseqs_report",
        f"{OUTDIR}/taxonomy/{{model}}/.{{prefix}}/mmseqs_lca.tsv",
        f"{OUTDIR}/taxonomy/{{model}}/.{{prefix}}/mmseqs_tophit_report",
    shell:
        f"""
        mmseqs easy-taxonomy {{input.generated}} {{input.prefix}} \
                {{params.db}} \
                {OUTDIR}/taxonomy/{{wildcards.model}}/.{{wildcards.prefix}}/mmseqs \
                {OUTDIR}/taxonomy/{{wildcards.model}}/.{{wildcards.prefix}}_tmp \
                --tax-lineage 1 \
                --format-mode 4 \
                --search-type 3
        """


rule sort_taxonomy_hits:
    input:
        f"{OUTDIR}/taxonomy/{{model}}/.{{prefix}}/mmseqs_tophit_aln",
    output:
        f"{OUTDIR}/taxonomy/{{model}}/{{prefix}}.csv",
    run:
        import polars as pl

        # Sort by evalue then bitscore ranking i.e. pick sequences with the lowest evalue,
        # (likely to have multiple sequences with the same evalue)
        # then get the best hit by bitscore
        df = pl.read_csv(input[0], separator="\t").with_columns(
            rank=pl.col("evalue").rank().over("query")
        )
        best_evalue = df.group_by("query").agg(min_rank=pl.col("rank").min())
        df = (
            df.join(best_evalue, on="query")
            .filter(pl.col("rank") == pl.col("min_rank"))
            .drop(["rank", "min_rank"])
        )
        df = (
            df.group_by("query")
            .agg(pl.all().top_k_by(k=1, by="bits"))
            .explode(pl.all().exclude("query"))
        )
        df.write_csv(output[0])


# * Sequence similarity


rule similarity:
    input:
        generated=f"{OUTDIR}/generated/{{model}}/{{prefix}}.fasta",
        prefix=f"{PREFIXES_FULL}/{{prefix}}.fasta",
    params:
        funcname=config.get("parasail", "sw_stats_striped_16"),
        kws="",
    output:
        "PLACEHOLDER",
    shell:
        "parasail_aligner -a {params.funcname} {params.kws} -g {output[0]}"


use rule similarity as similarity_to_prefix with:
    params:
        kws=lambda _, input: " ".join(
            [
                "-d",
                "-q",
                input.prefix,
                "-f",
                input.generated,
            ]
        ),
    singularity:
        ENV.singularity.get("similarity")
    output:
        temp(f"{OUTDIR}/.similarity_tmp/{{model}}/{{prefix}}-to_prefix.csv"),


use rule similarity as similarity_self with:
    params:
        kws=lambda _, input: " ".join(["-d", "-f", input.generated]),
    singularity:
        ENV.singularity.get("similarity")
    output:
        temp(f"{OUTDIR}/.similarity_tmp/{{model}}/{{prefix}}-self.csv"),


rule fmt_similarity_stats:
    input:
        generated=f"{OUTDIR}/generated/{{model}}/{{prefix}}.fasta",
        index=f"{INDICES}/{{model}}/{{prefix}}",
        tmp=f"{OUTDIR}/.similarity_tmp/{{model}}/{{prefix}}-{{type}}.csv",
    singularity:
        ENV.singularity.get("fmt_similarity_stats")
    params:
        cols=",".join(
            [
                "query",
                "index",
                "length1",
                "length2",
                "score",
                "end_query",
                "end_ref",
                "n_matches",
                "similarities",
                "length",
            ]
        ),
    output:
        f"{OUTDIR}/similarity/{{model}}/{{prefix}}-{{type}}.csv",
    shell:
        """
        xan rename -n {params.cols} {input.tmp} | \
                xan join index {input.index} - | \
                xan drop index > {output[0]}
         """
