from pathlib import Path
import time
from env import SnakeEnv
import os


configfile: "env.yaml"


"""
Output is structured as

<outdir>/
├── generated/
│   └── <model_name>/
│       └── <prefix_name>.fasta
├── prefix_comparison.csv
├── perturbation_sensitivity.csv
├── motifs_domains.csv
└── physicochemical.csv
"""

ENV = SnakeEnv.new(config)
OUTDIR = ENV.outdir
DATASETS = ENV.datasets

OUTPUTS = ENV.get_outputs()


rule all:
    input:
        *OUTPUTS["generated"],
        *OUTPUTS["motifs"],
        *OUTPUTS["metrics"],


rule generate:
    output:
        f"{OUTDIR}/generated/{{model}}/{{prefix}}.fasta",
    singularity:
        lambda wc: ENV.model_image(wc.get("model"))
    shell:
        lambda wc: ENV.model_script(wc.get("model"))


rule similarity_stats:
    input:
        f"{OUTDIR}/generated/{{model}}/{{prefix}}.fasta",
    params:
        prefix_fasta=lambda wc: ENV.prefix2file[wc.get("prefix")],
        funcname=config.get("parasail", "sw_stats_striped_16"),
        pref=f"{OUTDIR}/similarity_raw/{{model}}",
        cols=",".join(
            [
                "query",
                "index",
                "length1",
                "length2",
                "score",
                "end_query",
                "end_ref",
                "n_matches",
                "similarities",
                "length",
            ]
        ),
    output:
        raw="{params.pref}/{prefix}.csv",
    shell:
        """
        parasail_aligner -d \
                -q {params.prefix_fasta} \
                -f {input[0]} \
                -a {params.funcname} \
                -g {params.pref}.tmp.csv
        
        grep '>' {input[0]} | sed 's/^>//' | xan -n rename id | \
                xan enum > {params.pref}.seqnames.csv

        xan rename -n {params.cols} {params.pref}.tmp.csv | \
                xan join index {params.pref}.seqnames.csv - | \
                xan drop index > {output.raw}

        rm {params.pref}.seqnames.csv
        rm {params.pref}.tmp.csv 
        """


rule describe_protein_seqs:
    input:
        f"{OUTDIR}/generated/{{model}}/{{prefix}}.fasta",
    params:
        prefix_fasta=lambda wc: ENV.prefix2file[wc.get("prefix")],
    output:
        mean=f"{OUTDIR}/protein_descriptor_means/{{model}}/{{prefix}}.csv",
        vals=f"{OUTDIR}/protein_descriptor_raw/{{model}}/{{prefix}}.csv",


# rule compare_protein_descriptors:
# TODO: after getting the values from rule above, compare them
# across prefix groups


rule find_motifs:
    input:
        f"{OUTDIR}/generated/{{model}}/{{prefix}}.fasta",
    output:
        tsv=f"{OUTDIR}/motifs/{{model}}/{{prefix}}.tsv",
    params:
        prefix_fasta=lambda wc: ENV.prefix2file[wc.get("prefix")],
        thresh=ENV.fimo.thresh,
        motifs=lambda wc: ENV.get_motif_file(wc.get("prefix")),
    shell:
        """
        fimo --thresh {params.thresh} \
             --skip-matched-sequence \
             {params.motifs} {params.prefix_fasta} | \
             xan 
        fimo --thresh {params.thresh} \
             --skip-matched-sequence \
        
        """


rule classify_taxonomy:
    input:
        f"{OUTDIR}/generated/{{model}}/{{prefix}}.fasta",
    params:
        db=ENV.taxdb,
        prefix_fasta=lambda wc: ENV.prefix2file[wc.get("prefix")],
        outdir=lambda wc: f"{OUTDIR}/taxonomy/.{wc.get('prefix')}",
    threads: 4
    output:
        lambda wc: f"{OUTDIR}/taxonomy/.{wc.get('prefix')}/mmseqs_tophit_aln",
        lambda wc: f"{OUTDIR}/taxonomy/.{wc.get('prefix')}/mmseqs_report",
        lambda wc: f"{OUTDIR}/taxonomy/.{wc.get('prefix')}/mmseqs_lca.tsv",
        lambda wc: f"{OUTDIR}/taxonomy/.{wc.get('prefix')}/mmseqs_tophit_report",
    shell:
        f"""
        mmseqs easy-taxonomy {{input[0]}} {{params.prefix_fasta}} \
                {{params.db}} \
                {{params.outdir}}/mmseqs
                {OUTDIR}/taxonomy/.{{prefix}}_tmp
                --tax-lineage 1 \
                --format-mode 4 \
                --search-type 3
        """


rule sort_taxonomy_hits:
    input:
        f"{OUTDIR}/taxonomy/.{{prefix}}/mmseqs_tophit_aln",
    output:
        lambda wc: f"{OUTDIR}/taxonomy/{wc.get('prefix')}_tophit.csv",
    run:
        import polars as pl

        # Sort by evalue then bitscore ranking i.e. pick sequences with the lowest evalue,
        # (likely to have multiple sequences with the same evalue)
        # then get the best hit by bitscore

        infile = f"{input[0]}/mmseqs_tophit_aln"
        df = pl.read_csv(infile, separator="\t").with_columns(
            rank=pl.col("evalue").rank().over("query")
        )
        best_evalue = df.group_by("query").agg(min_rank=pl.col("rank").min())
        df = (
            df.join(best_evalue, on="query")
            .filter(pl.col("rank") == pl.col("min_rank"))
            .drop(["rank", "min_rank"])
        )
        df = (
            df.group_by("query")
            .agg(pl.all().top_k_by(k=1, by="bits"))
            .explode(pl.all().exclude("query"))
        )
        df.write_csv(output[0])
